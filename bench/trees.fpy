class Node:
    left: "Node | None"
    right: "Node | None"

    def __init__(self, left: "Node | None", right: "Node | None") -> None:
        self.left = left
        self.right = right


def make(depth: int) -> Node:
    if depth == 0:
        return Node(None, None)
    return Node(make(depth - 1), make(depth - 1))


def check(n: Node) -> int:
    l = n.left
    r = n.right
    if l is None or r is None:
        return 1
    return 1 + check(l) + check(r)


def main() -> None:
    max_depth = 18
    long_lived = make(max_depth)
    total = 0
    d = 4
    while d <= max_depth:
        iters = 1 << (max_depth - d + 4)
        for _ in range(iters):
            total += check(make(d))
        d += 2
    print(total, check(long_lived))


main()
