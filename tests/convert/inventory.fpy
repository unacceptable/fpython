"""A small untyped Python program used to test `fpython convert`."""


class Item:
    def __init__(self, name: str, price: float, qty: int = 0):
        self.name: str = name
        self.price: float = price
        self.qty: int = qty
        self.tags: list[str] = []

    def total(self) -> float:
        return self.price * self.qty

    def add_tag(self, tag: str) -> None:
        self.tags.append(tag)

    def describe(self) -> str:
        return f"{self.name} x{self.qty} @ {self.price:.2f}"


class Inventory:
    def __init__(self):
        self.items: dict[str, Item] = {}

    def add(self, item: Item) -> None:
        self.items[item.name] = item

    def value(self) -> float:
        total = 0.0
        for item in self.items.values():
            total += item.total()
        return total

    def cheapest(self) -> Item | None:
        best: Item | None = None
        for item in self.items.values():
            if best is None or item.price < best.price:
                best = item
        return best

    def names(self) -> list[str]:
        return sorted(self.items.keys())


def word_counts(text: str) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in text.lower().split():
        counts[word] = counts.get(word, 0) + 1
    return counts


def fib(n: int) -> list[int]:
    a, b = 0, 1
    seq: list[int] = []
    for _ in range(n):
        seq.append(a)
        a, b = b, a + b
    return seq


def main() -> None:
    inv = Inventory()
    apple = Item("apple", 0.5, 10)
    apple.add_tag("fruit")
    inv.add(apple)
    inv.add(Item("pear", 0.75, 4))
    inv.add(Item("melon", 3.0, 1))
    print(f"value: {inv.value():.2f}")
    print("names:", inv.names())
    cheap = inv.cheapest()
    if cheap is not None:
        print("cheapest:", cheap.describe())
    wc = word_counts("the cat and the hat and the bat")
    print(sorted(wc.items()))
    print(fib(10))


main()
