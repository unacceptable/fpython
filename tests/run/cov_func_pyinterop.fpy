import html.parser
import inspect
import asyncio
from typing import Any


@inspect.unwrap
class TagLister(html.parser.HTMLParser):
    kind = "lister"
    seen: int = 0

    def handle_starttag(self, tag: str, attrs: Any) -> None:
        print("start", tag)

    def handle_data(self, data: str) -> None:
        if data.strip():
            print("data", data.strip())

    @staticmethod
    def helper() -> str:
        return "static helper"

    @classmethod
    def label(cls) -> str:
        return "label"


@inspect.unwrap
def wrapped_fn(x: int) -> int:
    return x + 1


class Ticker:
    def __init__(self, n: int) -> None:
        self.n = n
        self.i = 0

    def __aiter__(self) -> "Ticker":
        return self

    async def __anext__(self) -> int:
        if self.i >= self.n:
            raise StopAsyncIteration
        self.i += 1
        return self.i


async def compute(x: int) -> int:
    await asyncio.sleep(0)
    return x * 2


async def nothing() -> None:
    await asyncio.sleep(0)
    return


async def main() -> int:
    total = 0
    async for v in Ticker(3):
        print("tick", v)
        total += v
    r = await compute(total)
    await nothing()
    return r


p = TagLister()
p.feed("<html><b>hi</b><i>there</i></html>")
print(TagLister.helper(), TagLister.label())
print(asyncio.run(main()))
print(wrapped_fn(4), TagLister.kind, TagLister.seen)
