from dataclasses import dataclass
from enum import Enum
from typing import ClassVar, Iterator, Protocol


class Color(Enum):
    RED = 1
    GREEN = 2


class Config:
    version = 3
    label = "cfg"
    retries: int = 5
    debug: bool = False
    ratio: float = 0.5

    def describe(self) -> str:
        return f"{self.label} v{self.version} r={self.retries} d={self.debug} {self.ratio}"


class Bag:
    def __init__(self, *items: int) -> None:
        self.items: list[int] = list(items)

    def __len__(self) -> int:
        return len(self.items)

    def __contains__(self, x: int) -> bool:
        return x in self.items


class Vec:
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y

    def __add__(self, o: "Vec") -> "Vec":
        return Vec(self.x + o.x, self.y + o.y)

    def __sub__(self, o: "Vec") -> "Vec":
        return Vec(self.x - o.x, self.y - o.y)

    def __mul__(self, k: int) -> "Vec":
        return Vec(self.x * k, self.y * k)

    def __neg__(self) -> "Vec":
        return Vec(-self.x, -self.y)

    def __eq__(self, o: "Vec") -> bool:
        return self.x == o.x and self.y == o.y

    def __lt__(self, o: "Vec") -> bool:
        return (self.x, self.y) < (o.x, o.y)

    def __hash__(self) -> int:
        return self.x * 31 + self.y

    def __repr__(self) -> str:
        return f"Vec({self.x}, {self.y})"

    def __str__(self) -> str:
        return f"<{self.x},{self.y}>"

    def __bool__(self) -> bool:
        return self.x != 0 or self.y != 0


class Loose:
    def __init__(self, v: int) -> None:
        self.v = v

    def __eq__(self, o: object) -> bool:
        if isinstance(o, Loose):
            return self.v == o.v
        return False


class Range3:
    def __init__(self, n: int) -> None:
        self.n = n
        self.i = 0

    def __iter__(self) -> "Range3":
        return self

    def __next__(self) -> int:
        if self.i >= self.n:
            raise StopIteration
        self.i += 1
        return self.i


class Tree:
    def __init__(self) -> None:
        self.vals: list[int] = []

    def add(self, v: int) -> "Tree":
        self.vals.append(v)
        return self

    def __iter__(self) -> Iterator[int]:
        for v in sorted(self.vals):
            yield v

    def __getitem__(self, i: int) -> int:
        return self.vals[i]


class Animal:
    sound: ClassVar[str] = "..."
    count: ClassVar[int] = 0

    def __init__(self, name: str) -> None:
        self.name = name
        Animal.count += 1

    def speak(self) -> str:
        return f"{self.name} says {self.sound_of()}"

    def sound_of(self) -> str:
        return "..."

    @classmethod
    def make(cls, name: str) -> "Animal":
        return cls(name)

    @staticmethod
    def kingdom() -> str:
        return "animalia"

    @property
    def upper(self) -> str:
        return self.name.upper()


class Dog(Animal):
    def __init__(self, name: str, tricks: int) -> None:
        super().__init__(name)
        self.tricks = tricks

    def sound_of(self) -> str:
        return "woof"


class Puppy(Dog):
    def sound_of(self) -> str:
        return "yip " + super().sound_of()


class Temperature:
    def __init__(self, c: float) -> None:
        self._c = c

    @property
    def celsius(self) -> float:
        return self._c

    def set_celsius(self, v: float) -> None:
        self._c = v

    @property
    def fahrenheit(self) -> float:
        return self._c * 9 / 5 + 32


class Greeter(Protocol):
    def greet(self) -> str:
        ...


class English:
    def greet(self) -> str:
        return "hello"


class French:
    def greet(self) -> str:
        return "bonjour"


def greet_all(gs: list[Greeter]) -> list[str]:
    return [g.greet() for g in gs]


@dataclass
class Item:
    name: str
    qty: int = 1
    note: str = ""


@dataclass(order=True)
class Version:
    major: int
    minor: int


@dataclass(frozen=True)
class Key:
    a: int
    b: str


class Stack[T]:
    def __init__(self) -> None:
        self.data: list[T] = []

    def push(self, v: T) -> None:
        self.data.append(v)

    def pop(self) -> T:
        return self.data.pop()

    def __len__(self) -> int:
        return len(self.data)


class Pair[A, B]:
    def __init__(self, a: A, b: B) -> None:
        self.a = a
        self.b = b

    def swap(self) -> "Pair[B, A]":
        return Pair(self.b, self.a)


c = Config()
print(c.describe())
Config.version = 4
c.retries = 6
print(c.describe(), Config.version)
b = Bag(1, 2, 3)
print(len(b), 2 in b, 9 in b)
v1 = Vec(1, 2)
v2 = Vec(3, 4)
print(v1 + v2, v2 - v1, v1 * 3, -v1, repr(v1))
print(v1 == Vec(1, 2), v1 == v2, v1 < v2, v2 < v1)
print(sorted([v2, v1]), bool(Vec(0, 0)), bool(v1))
print(len({v1, Vec(1, 2), v2}))
print(Loose(1) == Loose(1), Loose(1) == Loose(2))
print(list(Range3(4)))
for r in Range3(2):
    print("range3", r)
t = Tree().add(5).add(1).add(3)
print(list(t), t[0])
d = Dog("rex", 3)
p = Puppy("bit", 0)
a = Animal.make("generic")
print(d.speak(), p.speak(), a.speak())
print(Animal.kingdom(), d.upper, Animal.count, Animal.sound)
animals: list[Animal] = [d, p, a]
print([x.sound_of() for x in animals])
print(isinstance(p, Dog), isinstance(a, Dog))
tmp = Temperature(100.0)
print(tmp.celsius, tmp.fahrenheit)
tmp.set_celsius(0.0)
print(tmp.celsius, tmp.fahrenheit)
print(greet_all([English(), French()]))
it = Item("apple")
it.note = "red"
print(it, Item("pear", 3))
print(Version(1, 2) < Version(1, 3), sorted([Version(2, 0), Version(1, 9)]))
k = Key(1, "x")
print(k, k == Key(1, "x"), hash(k) == hash(Key(1, "x")))
s: Stack[int] = Stack()
s.push(1)
s.push(2)
print(s.pop(), len(s))
ss: Stack[str] = Stack()
ss.push("z")
print(ss.pop())
pr = Pair(1, "one")
sw = pr.swap()
print(sw.a, sw.b)
print(Color.RED, Color.GREEN.value, Color.RED.name, Color.RED == Color.RED)
print(repr(Color.GREEN))
