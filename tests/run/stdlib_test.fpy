import math
import json
import random
import string
import heapq
import bisect
from collections import deque
from os import path
from typing import Any


class Stack[T]:
    items: list[T]

    def __init__(self) -> None:
        self.items = []

    def push(self, x: T) -> None:
        self.items.append(x)

    def pop(self) -> T:
        return self.items.pop()

    def __len__(self) -> int:
        return len(self.items)


def main() -> None:
    print(
        math.sqrt(16.0),
        math.floor(2.7),
        math.ceil(2.1),
        math.pi,
        math.gcd(12, 18),
        math.factorial(10),
    )
    print(
        math.isclose(0.1 + 0.2, 0.3),
        math.log(math.e),
        math.log(8.0, 2.0),
        math.hypot(3.0, 4.0),
        math.comb(5, 2),
        math.isqrt(17),
    )
    data: Any = json.loads(
        '{"name": "fpy", "tags": ["a", "b"], "n": 3, "pi": 3.5, "ok": true, "none": null}',
    )
    print(data["name"], data["tags"][1], data["n"] + 1, data["ok"], data["none"])
    print(json.dumps(data, sort_keys=True))
    print(json.dumps([1, "two", {"three": 3.0}]))
    random.seed(42)
    r = random.randint(1, 6)
    print(1 <= r <= 6, 0.0 <= random.random() < 1.0)
    xs = [5, 1, 4, 2, 3]
    random.shuffle(xs)
    print(sorted(xs), random.choice([7, 7, 7]))
    print(string.ascii_lowercase[:5], string.digits)
    h: list[int] = []
    for v in [5, 3, 8, 1, 9]:
        heapq.heappush(h, v)
    print([heapq.heappop(h) for _ in range(3)])
    a = [1, 3, 5, 7]
    bisect.insort(a, 4)
    print(a, bisect.bisect_left(a, 5), bisect.bisect_right(a, 5))
    dq: deque[int] = deque()
    for i in range(5):
        dq.append(i)
    dq.appendleft(-1)
    print(dq.popleft(), dq.pop(), len(dq), list(dq))
    s: Stack[str] = Stack()
    s.push("a")
    s.push("b")
    print(s.pop(), len(s))
    si = Stack[int]()
    si.push(10)
    print(si.pop() + 1)
    print(
        path.join("a", "b", "c.txt"),
        path.basename("/x/y.py"),
        path.dirname("/x/y.py"),
        path.splitext("f.tar.gz"),
    )


main()
