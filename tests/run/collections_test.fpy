def main() -> None:
    d: dict[str, int] = {}
    for w in "the quick brown fox jumps over the lazy dog the end".split():
        d[w] = d.get(w, 0) + 1
    print(d)
    print(sorted(d.items(), key=lambda kv: (-kv[1], kv[0]))[:3])
    print(list(d.keys())[:3], sum(d.values()))
    for k, v in d.items():
        if v > 1:
            print(k, v)
    del d["fox"]
    print("fox" in d, "dog" in d, len(d))
    print(d.pop("dog"), d.pop("zzz", -1), d.setdefault("new", 7), d["new"])

    s = {1, 2, 3}
    s.add(4)
    s.discard(1)
    t = {3, 4, 5}
    print(sorted(s | t), sorted(s & t), sorted(s - t), sorted(s ^ t), 3 in s, 1 in s)

    nums = [5, 3, 8, 1, 9, 2]
    nums.sort()
    print(nums, nums[1:4], nums[::-1], nums[-2:], nums[::2])
    nums.insert(0, 100)
    print(nums.pop(), nums.pop(0), nums.index(5), nums.count(3))
    nums.remove(3)
    print(nums, min(nums), max(nums), sorted(nums, reverse=True))
    squares = [x * x for x in range(10) if x % 2 == 0]
    print(squares)
    pairs = [(i, j) for i in range(3) for j in range(i)]
    print(pairs)
    m = {k: len(k) for k in ["a", "bb", "ccc"]}
    print(m)
    sq = {x % 3 for x in range(10)}
    print(sorted(sq))
    nested = [[i * j for j in range(3)] for i in range(3)]
    print(nested, nested[2][1])
    t2 = (1, "two", 3.0)
    a, b, c = t2
    print(t2, a, b, c, t2[1], len(t2))
    first, *rest = [1, 2, 3, 4]
    print(first, rest)
    x, y = 1, 2
    x, y = y, x
    print(x, y)
    print(list(enumerate(["a", "b"])), list(zip([1, 2, 3], ["x", "y", "z"])))
    for i, (n, ch) in enumerate(zip([10, 20], "ab")):
        print(i, n, ch)
    print(any(v > 8 for v in nums), all(v > 0 for v in nums), sum(v for v in nums if v % 2 == 0))
    words = ["banana", "Apple", "cherry"]
    print(
        sorted(words),
        sorted(words, key=str.lower)
        if False
        else sorted(words, key=lambda w: w.lower()),
    )
    print(max(words, key=len), min([3, 1, 2]), max(4, 9, 2))
    print([1, 2] + [3], [0] * 3, [1, 2] == [1, 2], [1, 2] < [1, 3])
    print(list(reversed([1, 2, 3])), list(range(10, 0, -3)))


main()
