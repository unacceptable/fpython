def main() -> None:
    s = "  Hello, World!  "
    print(s.strip(), s.lstrip(), s.rstrip(), s.upper(), s.lower())
    t = s.strip()
    print(t.split(", "), t.replace("l", "L"), t.find("World"), t.find("zzz"), t.count("l"))
    print(t.startswith("Hello"), t.endswith("!"), t[0], t[-1], t[7:12], t[::-1])
    print("-".join(["a", "b", "c"]), ",".join(str(i) for i in range(5)))
    print("abc" * 3, "x" + "y", len("héllo"), "héllo"[1], "héllo".upper())
    print("a,b,,c".split(","), "  a b   c ".split(), "line1\nline2\n".splitlines())
    print(
        "42".isdigit(),
        "abc".isalpha(),
        "abc1".isalnum(),
        "   ".isspace(),
        "Title Case".istitle()
        if False
        else True,
    )
    print(
        int("123") + 1,
        float("2.5") * 2,
        str(3.0),
        str(1e20),
        str(1.5e-7),
        repr("it's"),
        repr('say "hi"'),
    )
    print(ord("A"), chr(97), hex(255), bin(5), oct(8), hex(-255))
    name = "fpython"
    n = 42
    pi = 3.14159265
    print(f"{name!r:>12}|{n:05d}|{pi:.3f}|{n:x}|{n:,}|{pi:10.2e}|{name:^11}|{n=}")
    print(f"{1234567.891:,.2f} {0.25:.0%} {-5:+d} {5:+d} {'left':<8}| {3.0} {10/4}")
    print("a" < "b", "abc" == "abc", "b" > "abc", "x" in "xyz", "q" not in "xyz")
    print(
        "CamelCase".swapcase(),
        "hello world".title(),
        "hello".capitalize(),
        "ab".center(6, "*"),
        "7".zfill(3),
    )
    print(
        "prefix_name".removeprefix("prefix_"),
        "file.txt".removesuffix(".txt"),
        "a=b=c".partition("="),
        "a=b=c".rpartition("="),
    )
    print("tab\tsep", "back\\slash", "unié", "\x41")
    print(" ".join(reversed("hello world".split())))
    for ch in "héy":
        print(ch, end="|")
    print()
    print(str(True), str(None), str([1, "a"]), str({"k": [1.5]}), repr((1,)), str(()))
    print(
        round(2.5),
        round(3.5),
        round(2.675, 2),
        int(3.9),
        int(-3.9),
        abs(-7),
        abs(-2.5),
        divmod(17, 5),
        divmod(-7, 2),
    )
    print(
        7 // 2,
        -7 // 2,
        7 % 3,
        -7 % 3,
        7 / 2,
        2**10,
        2.0**0.5,
        1 << 10,
        255 & 15,
        5 | 2,
        6 ^ 3,
        ~5,
    )
    print(0.1 + 0.2, 1 / 3, 100.0, 1e16, 123456789.0, 1.0e-5, -0.0, float("inf"), 2**62)


main()
