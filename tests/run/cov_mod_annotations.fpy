from typing import (
    Any,
    Callable,
    ClassVar,
    Final,
    Iterable,
    Iterator,
    List,
    Dict,
    Set,
    Tuple,
    Literal,
    Optional,
    Sequence,
    Mapping,
    Union,
    Annotated,
    Self,
    Never,
    NoReturn,
)
from collections.abc import Generator

type IntList = list[int]
type MaybeStr = str | None
type Pair = tuple[int, str]
type Grid = list[list[int]]
type Num = int | float
type NumOrNone = Union[int, None]
type ReprFn = Callable[[int], str]


def opt_list(x: Optional[List[int]]) -> int:
    if x is None:
        return -1
    return len(x)


def mapping(d: Mapping[str, int], s: Set[str], t: Tuple[int, int]) -> int:
    return len(d) + len(s) + t[0] + t[1]


def seq(xs: Sequence[float]) -> float:
    return sum(xs)


def var_tuple(t: tuple[int, ...]) -> int:
    total = 0
    for v in t:
        total += v
    return total


def empty_tuple(t: tuple[()]) -> int:
    return len(t)


def union3(x: Union[int, str, float]) -> str:
    if isinstance(x, int):
        return "int"
    if isinstance(x, str):
        return "str"
    return "float"


def union_opt(x: int | str | None) -> str:
    if x is None:
        return "none"
    return union3(x)


def lit(mode: Literal["a", "b"], n: Literal[3], f: Literal[True], g: Literal[1.5]) -> str:
    return f"{mode}{n}{f}{g}"


def final_ann(x: Final[int], y: Annotated[str, "meta"]) -> str:
    return y * x


def gen(n: int) -> Generator[int, None, None]:
    for i in range(n):
        yield i * i


def it(xs: Iterable[str]) -> str:
    return ",".join(xs)


def callback(f: Callable[[int, int], int], g: Callable[[], str]) -> str:
    return g() + str(f(3, 4))


def fwd(p: "Pt") -> int:
    return p.x


def nothing() -> None:
    pass


def anyfn(x: Any, y: object) -> str:
    return str(x) + str(y)


def grid_sum(g: Grid) -> int:
    return sum(sum(r) for r in g)


def num(x: Num) -> float:
    if isinstance(x, int):
        return float(x * 2)
    return x * 2


def pairs(p: Pair) -> str:
    return f"{p[0]}:{p[1]}"


def ms(x: MaybeStr) -> str:
    return x if x is not None else "?"


def il(x: IntList) -> int:
    return len(x)


def non(x: NumOrNone) -> int:
    return 0 if x is None else x


def apply(f: ReprFn, v: int) -> str:
    return f(v)


def nested(d: Dict[str, List[Tuple[int, Optional[str]]]]) -> int:
    n = 0
    for k, v in d.items():
        for a, b in v:
            n += a
            if b is not None:
                n += len(b)
    return n


def bytes_ann(b: bytes, c: bytearray) -> int:
    return len(b) + len(c)


def kw(a: int, *rest: int, scale: int = 1, **opts: str) -> str:
    return f"{a} {sum(rest) * scale} {sorted(opts.items())}"


class Pt:
    x: int
    origin_count: ClassVar[int] = 0
    unit: ClassVar = 7

    def __init__(self, x: int) -> None:
        self.x = x

    def clone(self) -> Self:
        return Pt(self.x)

    def same(self, other: Self) -> bool:
        return self.x == other.x


def stop() -> Never:
    raise RuntimeError("never")


def stop2() -> NoReturn:
    raise ValueError("noreturn")


def main() -> None:
    try:
        stop()
    except RuntimeError as e:
        print(e)
    try:
        stop2()
    except ValueError as e2:
        print(e2)
    print(opt_list(None), opt_list([1, 2, 3]))
    print(mapping({"a": 1}, {"x", "y"}, (3, 4)))
    print(seq([1.5, 2.5]))
    print(var_tuple is not None)
    print(empty_tuple(()))
    print(union3(1), union3("s"), union3(2.5))
    print(union_opt(None), union_opt(3), union_opt("q"))
    print(lit("a", 3, True, 1.5))
    print(final_ann(3, "ab"))
    print(list(gen(4)))
    print(it(["a", "b"]))
    print(callback(lambda a, b: a * b, lambda: "r="))
    print(fwd(Pt(9)))
    nothing()
    print(anyfn(1, "z"))
    print(grid_sum([[1, 2], [3, 4]]))
    print(num(3), num(1.25))
    print(pairs((5, "five")))
    print(ms(None), ms("s"))
    print(il([1, 2]))
    print(non(None), non(5))
    print(apply(lambda v: "#" * v, 3))
    print(nested({"k": [(1, None), (2, "abc")]}))
    print(bytes_ann(b"abc", b"de"))
    print(kw(1, 2, 3, scale=2, z="1", b="2"))
    p = Pt(4)
    print(p.clone().x, p.same(Pt(4)), Pt.origin_count, Pt.unit)
    Pt.origin_count = 5
    print(Pt.origin_count)


main()
