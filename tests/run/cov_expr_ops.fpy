from typing import Any, Callable


class Vec:
    x: int
    y: int

    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y

    def __neg__(self) -> "Vec":
        return Vec(-self.x, -self.y)

    def __rmul__(self, k: int) -> "Vec":
        return Vec(self.x * k, self.y * k)

    def __lt__(self, other: "Vec") -> bool:
        return (self.x, self.y) < (other.x, other.y)

    def __repr__(self) -> str:
        return f"Vec({self.x}, {self.y})"


class Box:
    items: list[int]

    def __init__(self, items: list[int]) -> None:
        self.items = items

    def __len__(self) -> int:
        return len(self.items)


class Plain:
    v: int

    def __init__(self, v: int) -> None:
        self.v = v


def arith() -> None:
    a = 17
    b = 5
    print(a - b, a * b, a / b, a // b, a % b, a**2, a << 2, a >> 1)
    print(a & b, a | b, a ^ b, ~a, -a, +a)
    f = 7.5
    g = 2.0
    print(f - g, f * g, f / g, f // g, f % g, f**g, -f, +f)
    print(-7.5 // 2.0, -7.5 % 2.0, 7.5 // -2.0)
    h: float = 3
    print(h + 0.5)
    t = True
    print(+t, -t, not t)
    print(t & False, t | False, t ^ True)
    big = -9223372036854775807 - 1
    print(big)
    print(3 * "ab", "ab" * 3, b"xy" + b"z")
    print([1, 2] * 2, 2 * [3, 4], [1] + [2, 3])
    print((1, "a") + (2.5, True))
    print({1, 2, 3} | {4}, {1, 2, 3} & {2, 3, 9}, {1, 2, 3} - {1}, {1, 2} ^ {2, 3})
    d1 = {"a": 1, "b": 2}
    d2 = {"b": 20, "c": 30}
    print(d1 | d2)
    v = Vec(1, 2)
    print(-v, 3 * v)
    print(v < Vec(1, 3), Vec(2, 0) > v)
    x: Any = 5
    print(-x, x + 1, 2 * x)
    print(1e300 * 1e300, -(1e300 * 1e300))
    print(0.5 + 1.0, 1.0)


def boolops(xs: list[int], name: str | None, o: int | None) -> None:
    print(xs or [9], name or "anon", o or 0)
    print("" or "empty", 0 or 7, 3 and 4)
    print(xs or [1] or [2])
    b = Box([])
    print(bool(b), not b, len(b))
    print(bool(Plain(1)))
    print(not 0.0, not 1.5, not b"", not b"x", not {}, not {1: 2}, not set(), not (1,), not ())
    print(not None)
    f: Callable[[int], int] = lambda q: q + 1
    print(not f)
    if xs and name:
        print("both")
    e = 1.5 or 2.5
    print(e)


def condexpr(n: int) -> None:
    a = "pos" if n > 0 else "nonpos"
    b = 1 if n > 0 else 2.5
    c: int | None = n if n > 3 else None
    print(a, b + 0.25, c)


def is_ops(p: Plain | None) -> None:
    print(p is None, p is not None)
    q = p
    print(p is q)
    print(None is None)


def membership() -> None:
    t = (1, 2, 3)
    print(2 in t, 5 in t, 5 not in t)
    print("a" in ("a", "b"), "c" in ("a", "b"))
    print("ell" in "hello", 3 in {3: 4}, 3 in {1, 2})
    print(9 in [1, 2])
    print(b"ab" == b"ab", b"ab" != b"ac", b"a" < b"b")


def chains(a: int, b: int, c: int) -> None:
    print(a < b < c, a < b > c, a == a <= b, 1 < 2 < 3 < 4 < 2)


def main() -> None:
    arith()
    boolops([], None, None)
    boolops([4, 5], "x", 3)
    condexpr(5)
    condexpr(-1)
    is_ops(None)
    is_ops(Plain(2))
    membership()
    chains(1, 2, 3)
    chains(3, 2, 1)


main()
