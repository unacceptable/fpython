from typing import Callable

double: Callable[[int], int] = lambda x: x * 2


class Meter:
    def __init__(self, start: int = 0) -> None:
        self.value = start

    def bump(self, by: int = 1) -> int:
        self.value += by
        return self.value


class Crate[T]:
    def __init__(self, item: T) -> None:
        self.item = item

    def take(self) -> T:
        return self.item
