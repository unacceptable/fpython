from typing import Callable, Iterable, cast as conv

import collections
import functools

import cov_call_pkg.tools as tools


class Shape:
    def area(self) -> float:
        return 0.0


class Square(Shape):
    def __init__(self, s: float) -> None:
        self.s = s

    def area(self) -> float:
        return self.s * self.s


def apply[T, R](x: T, f: Callable[[T], R]) -> R:
    return f(x)


def first[T](xs: list[T]) -> T:
    return xs[0]


def pick[T](*xs: T) -> T:
    return xs[-1]


def total[T](xs: Iterable[T]) -> int:
    n = 0
    for _ in xs:
        n += 1
    return n


def or_default[T](x: T | None, d: T) -> T:
    if x is None:
        return d
    return x


def keys_of[K, V](d: dict[K, V]) -> list[K]:
    return list(d.keys())


def swap[A, B](t: tuple[A, B]) -> tuple[B, A]:
    return (t[1], t[0])


def widen[T](x: T | str) -> str:
    return str(x)


def biggest[S: Shape](shapes: list[S]) -> S:
    best = shapes[0]
    for s in shapes:
        if s.area() > best.area():
            best = s
    return best


def join_all(*parts: str, sep: str = "+") -> str:
    return sep.join(parts)


def add3(a: int, b: int, c: int) -> int:
    return a * 100 + b * 10 + c


def kw_collect(name: str, **opts: int) -> str:
    out = name
    for k, v in opts.items():
        out += f" {k}={v}"
    return out


def kw_strs(**opts: str) -> int:
    return len(opts)


def generics() -> None:
    print(apply(3, lambda v: str(v) + "!"))
    print(apply("ab", lambda s: len(s)))
    print(first(xs=[7, 8]))
    print(pick(1, 2, 3), pick("a", "b"))
    print(total([1, 2, 3]), total({"a", "b"}), total("hello"))
    print(or_default(None, 5), or_default(3, 5))
    print(keys_of({"x": 1, "y": 2}))
    print(swap((1, "one")))
    print(widen(42), widen("s"))
    print(biggest([Square(2.0), Square(3.0), Square(1.0)]).s)
    print(functools.reduce(lambda acc, x: acc + x, [1, 2, 3], 10))


def splats() -> None:
    nums = [4, 5, 6]
    print(join_all("a", "b", "c"), join_all(sep="-"), join_all("x", "y", sep="/"))
    words = ["p", "q"]
    print(join_all(*words))
    print(join_all(*words, sep=":"))
    t = (1, 2, 3)
    print(add3(*t))
    pair = (7, 8)
    print(add3(*pair, 9))
    print(add3(1, *(2, 3)))
    print(kw_collect("n"), kw_collect("m", a=1, b=2))
    print(kw_collect(name="k", z=26))
    print(kw_strs(), kw_strs(u="1", v="2", w="3"))
    print(sum(nums))


def casting() -> None:
    v = conv(int, 5)
    print(v + 1)
    s: Shape = Square(4.0)
    sq = conv(Square, s)
    print(sq.s)
    o = conv(int | None, 3)
    print(o)
    ys: list[int] = list(range(3))
    print(ys)


def modules() -> None:
    d: collections.deque[int] = collections.deque()
    d.append(1)
    d.append(2)
    print(len(d))
    c = collections.Counter(["a", "b", "a"])
    print(c["a"], c["b"])
    print(tools.double(21))
    m = tools.Meter(5)
    print(m.bump(), m.bump(by=3), tools.Meter().bump())
    cr = tools.Crate("crated")
    print(cr.take())
    ci = tools.Crate(7)
    print(ci.take() + 1)


generics()
splats()
casting()
modules()
