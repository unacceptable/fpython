"""Regression cases for fixed bugs (see the bug backlog in REQUIREMENTS.md)."""

from typing import Any, Callable, ClassVar, Generator, Iterable, Iterator, Optional, TypeAlias, cast

# B15: implicit and explicit type aliases
IntList = list[int]
MaybeInt = int | None
OptInt = Optional[int]
Pair: TypeAlias = tuple[int, str]


def bytes_ops() -> None:
    # B1: bytes slicing and construction
    b = b"hello world"
    print(b[0:5], b[6:], b[::3], bytes(3), bytes([104, 105]))
    # B4: iterating bytes in builtins
    print(list(b"hi"), sorted(b"ba"), [x for x in b"z"])
    # B7: repeat and membership
    print(b"ab" * 2, 3 * b"x", b"" * 5)
    print(98 in b"abc", b"bc" in b"abc", b"z" in b"abc", b"" in b"")


def iterator_membership() -> None:
    # B7: `in` on range() and on iterators consumes up to the match
    print(4 in range(5), 7 in range(0, 10, 2), 6 in range(0, 10, 2))
    r = iter([1, 2, 3, 4])
    print(2 in r, list(r))


def local_imports() -> None:
    # B3: function-local imports of modules not imported at top level
    import os.path
    from collections import Counter

    print(os.path.basename("/a/b"), Counter(list("aab"))["a"])


def seq(xs: list[int]) -> str:
    # B5 / star patterns: elements after a star index from the end
    match xs:
        case [*rest, 9]:
            return f"ends9 {rest}"
        case [first, *mid, last]:
            return f"{first} {mid} {last}"
        case _:
            return "short"


def tup(t: tuple[int, int, int, int]) -> str:
    match t:
        case (a, b, c):
            return "three"
        case (a, *mid, z):
            return f"{a} {mid} {z}"
    return "no"


def mapping_rest() -> None:
    # B5: `**rest` excludes the matched keys
    d: dict[str, int] = {"a": 3, "c": 4}
    match d:
        case {"a": aa, **rest}:
            print(aa, sorted(rest))


class Base:
    def __init__(self, n: int) -> None:
        self.n = n

    def who(self) -> str:
        return "base"


class Child(Base):
    def who(self) -> str:
        return "child"


def make(t: type[Base], n: int) -> Base:
    # B20: a type[Base] value may hold a subclass
    return t(n)


def dyn_iter(v: Any) -> list[int]:
    # B21: Any -> Iterator[int] unboxes the elements
    return list(cast(Iterator[int], v))


def dyn_floats(v: Any) -> float:
    t = 0.0
    for x in cast(Iterator[float], v):
        t += x
    return t


def apply(x: int, key: Callable[[int], int]) -> int:
    return key(x)


def dynamic_calls() -> None:
    # B33: a lambda passed through an Any-typed callee; B32: next() on Any iterators
    fn: Any = apply
    print(fn(3, lambda v: v * 2))
    it: Any = iter([7, 8])
    print(next(it), next(it, 0), next(it, 0))


def nested_signatures(base: int) -> str:
    # B6: nested defs keep defaults, keywords, *args and **kwargs
    def fmt(*parts: int, sep: str = "-", **extra: int) -> str:
        return sep.join(str(p + base) for p in parts) + str(sorted(extra.items()))

    def fact(n: int, acc: int = 1) -> int:
        return acc if n <= 1 else fact(n - 1, acc * n)

    def inner() -> str:
        return fmt(1, 2, sep="+", z=3)

    return fmt(1, 2, 3) + " " + inner() + " " + str(fact(5)) + " " + str(fact(n=3))


def exception_texts() -> None:
    # B9: str/repr of exceptions and unpacking messages match CPython
    d: dict[str, int] = {}
    try:
        d["k"]
    except KeyError as e:
        print(e, repr(e))
    try:
        raise KeyError("k")
    except KeyError as e:
        print(e, repr(e))
    try:
        {1: 2}[3]
    except KeyError as e:
        print(e, repr(e))
    try:
        assert False
    except AssertionError as e:
        print(repr(e), str(e) == "")
    try:
        assert 1 > 2, "math"
    except AssertionError as e:
        print(repr(e))
    print(repr(ValueError()), repr(ValueError(3)), str(ValueError(None)), repr(RuntimeError("x")))
    for xs in [[1, 2, 3], [1]]:
        try:
            a, b = xs
        except ValueError as e:
            print(e)
    try:
        next(iter([]))
    except StopIteration as e:
        print(repr(e))


class ParseError(Exception):
    pass


class Money:
    def __init__(self, cents: int) -> None:
        self.cents = cents

    def __format__(self, spec: str) -> str:
        return "$" + format(self.cents / 100, spec if spec else ".2f")

    def __str__(self) -> str:
        return f"{self.cents}c"


def fstrings() -> None:
    # B8: __format__ for plain fields, !a / ascii(), and `=` debug text whitespace
    m = Money(1234)
    s = "héllo €𝄞"
    print(f"{m} {m:.1f} {m!s} {str(m)}")
    print(f"{s!a}", ascii(s), ascii([s, 1]), f"{s!a:>30}|")
    value = 3.14159
    print(f"{value = :.1f}|{value= }|{value =}")


class Bag:
    # B10: field types inferred from *args / **kwargs / keyword-only params and their copies
    def __init__(self, *items: int, tags: list[str], **opts: float) -> None:
        self.items = list(items)
        self.sorted_items = sorted(items)
        self.unique = set(items)
        self.tags = tags.copy()
        self.opts = dict(opts)


def use_aliases(x: IntList, b: MaybeInt, c: OptInt, p: Pair) -> IntList:
    return x + [b or 0, c or 0, p[0]]


def setup_globals() -> None:
    # B30: globals created inside a function
    global late, label
    late = 42
    if late:
        label = "set"


def describe(x: int | str | None) -> str:
    if x is None:
        return "none"
    return str(x)


def widen(n: int | None, s: str | None) -> str:
    # B23: `T | None` passes where a wider union with None is expected
    return describe(n) + describe(s)


def upper_or_none(name: str | None) -> str | None:
    # B14: operands of a value-returning `and` are narrowed by the earlier ones
    return name and name.upper()


def joined(a: str | None, b: str | None) -> str | None:
    return a and b and (a + b)


class Config:
    # B11: `x: T = v` is an instance field with a class-level default...
    version = 3
    retries: int = 5


class Tally:
    # ...unless the program assigns it through the class
    count: int = 0
    limit: ClassVar[int] = 10

    def __init__(self) -> None:
        Tally.count += 1

    @classmethod
    def reset(cls) -> None:
        cls.count = 0


def class_attrs() -> None:
    c = Config()
    c.retries = 6
    d = Config()
    print(c.retries, d.retries, Config.retries, Config.version)
    Tally()
    Tally()
    print(Tally.count, Tally.limit)
    Tally.reset()
    print(Tally.count)


class Upto:
    def __init__(self, n: int) -> None:
        self.n = n

    def __iter__(self) -> Iterator[int]:
        i = 0
        while i < self.n:
            yield i
            i += 1


def consume(it: Iterable[int]) -> int:
    # B22: a class with __iter__ is an Iterable before its iteration is compiled
    total = 0
    for x in it:
        total += x
    return total


def total(t: tuple[int, ...]) -> int:
    # B16: tuple[T, ...] is a real variable-length tuple
    s = 0
    for x in t:
        s += x
    return s


def describe_words(t: tuple[str, ...]) -> str:
    return f"{len(t)} {t[0] if t else '-'} {t[-1] if t else '-'} {t[1:]} {'b' in t} {t}"


def var_tuples() -> None:
    nums: tuple[int, ...] = (1, 2, 3)
    print(
        total(nums),
        total((4, 5)),
        total(()),
        nums[1],
        nums[::-1],
        nums + (9,),
        max(nums),
        sorted(nums, reverse=True),
    )
    print(describe_words(("a", "b", "c")), describe_words(()))
    words = tuple(["x", "y"])
    print(words, len(words), words == ("x", "y"), hash(nums) == hash((1, 2, 3)))
    a, b, c = nums
    first, *rest = nums
    print(a + b + c, first, rest, list(nums), set(nums) == {1, 2, 3}, nums.count(2), nums.index(3))


def exception_details() -> None:
    # B12: exception args / __cause__ / __context__
    try:
        raise ValueError("bad")
    except ValueError as e:
        print(e.args, len(e.args), KeyError().args, RuntimeError(3).args)
    try:
        try:
            int("x")
        except ValueError as e:
            raise ParseError("load failed") from e
    except ParseError as err:
        print(repr(err), repr(err.__cause__), err.__context__ is err.__cause__)
    try:
        try:
            raise KeyError("k")
        except KeyError:
            raise RuntimeError("while handling")
    except RuntimeError as err:
        print(err.__cause__, repr(err.__context__))


def averager() -> Generator[float, float, None]:
    # B12: generator send / throw / close
    total = 0.0
    count = 0
    avg = 0.0
    while True:
        value = yield avg
        total += value
        count += 1
        avg = total / count


def guarded() -> Iterator[int]:
    try:
        yield 1
        yield 2
    except ValueError:
        yield 99
    finally:
        print("cleanup")


def generator_methods() -> None:
    a = averager()
    next(a)
    print(a.send(10.0), a.send(20.0), a.send(30.0))
    g = guarded()
    print(next(g), g.throw(ValueError("boom")))
    g.close()
    h = guarded()
    print(next(h))
    h.close()


print(consume(Upto(4)))
bytes_ops()
iterator_membership()
local_imports()
print(seq([1, 2, 9]), seq([1, 2, 3, 4]), seq([5]), seq([9]))
print(tup((1, 2, 3, 4)))
mapping_rest()
print(make(Child, 2).who(), make(Base, 3).who(), make(Child, 4).n)
print(dyn_iter(iter([4, 5])), dyn_iter([6]), dyn_floats([1.5, 2.5]))
dynamic_calls()
print(nested_signatures(10))
exception_texts()
print(repr(ParseError()), repr(ParseError("bad")))
fstrings()
bag = Bag(3, 1, 3, tags=["x"], w=1.5)
print(bag.items, bag.sorted_items, sorted(bag.unique), bag.tags, bag.opts)
# B31: float.hex(); B34: str(bytes), bytes(bytes), sum() of an empty literal
for x in [1.0, 0.1, -2.5, 0.0, -0.0, 1e-310, 1e300]:
    print(x.hex())
raw = b"abc"
print(
    str(raw),
    str(raw, "utf-8"),
    bytes(raw),
    bytes(raw) == raw,
    sum([], start=3),
    sum([]),
    sum([], 2.5),
)
print(use_aliases([1], None, 3, (4, "s")))
setup_globals()
print(late + 1, label)
print(widen(None, "a"), widen(3, None))
print(
    upper_or_none(None),
    upper_or_none(""),
    upper_or_none("x"),
    joined("a", "b"),
    joined("a", None),
)
class_attrs()
var_tuples()
exception_details()
generator_methods()
