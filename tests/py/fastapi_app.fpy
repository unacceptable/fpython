from fastapi import FastAPI, HTTPException
from fastapi.testclient import TestClient
from pydantic import BaseModel
from typing import Any

app = FastAPI(title="fpython demo")
store: dict[int, dict[str, Any]] = {}


class Item(BaseModel):
    name: str
    price: float
    tags: list[str] = []


@app.get("/")
def root() -> dict[str, str]:
    return {"message": "hello from native code"}


@app.get("/square/{n}")
def square(n: int, offset: int = 0) -> dict[str, int]:
    return {"n": n, "square": n * n + offset}


@app.post("/items/{item_id}")
def create_item(item_id: int, item: Item) -> dict[str, Any]:
    store[item_id] = {"name": item.name, "price": item.price, "tags": item.tags}
    return {"id": item_id, "stored": True}


@app.get("/items/{item_id}")
def read_item(item_id: int) -> dict[str, Any]:
    if item_id not in store:
        raise HTTPException(status_code=404, detail="item not found")
    return store[item_id]


def main() -> None:
    client = TestClient(app)
    print(client.get("/").json())
    print(client.get("/square/7", params={"offset": 1}).json())
    r = client.post("/items/1", json={"name": "widget", "price": 2.5, "tags": ["a", "b"]})
    print(r.status_code, r.json())
    print(client.get("/items/1").json())
    print(client.get("/items/9").status_code, client.get("/items/9").json())
    print(client.get("/square/abc").status_code)
    print(client.post("/items/2", json={"name": "bad"}).status_code)


main()
