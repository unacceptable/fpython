# fpython stdlib: json (values are Any: dict[str, Any] | list[Any] | str | int | float | bool | None)
from typing import Any


class JSONDecodeError(ValueError):
    pass


def dumps(obj: Any, indent: int = -1, sort_keys: bool = False) -> str:
    out: list[str] = []
    _dump(obj, out, indent, 0, sort_keys)
    return "".join(out)


def _quote(s: str) -> str:
    parts: list[str] = ['"']
    for ch in s:
        if ch == '"':
            parts.append('\\"')
        elif ch == "\\":
            parts.append("\\\\")
        elif ch == "\n":
            parts.append("\\n")
        elif ch == "\r":
            parts.append("\\r")
        elif ch == "\t":
            parts.append("\\t")
        elif ord(ch) < 32:
            parts.append(f"\\u{ord(ch):04x}")
        else:
            parts.append(ch)
    parts.append('"')
    return "".join(parts)


def _dump(obj: Any, out: list[str], indent: int, level: int, sort_keys: bool) -> None:
    if obj is None:
        out.append("null")
    elif isinstance(obj, bool):
        out.append("true" if obj else "false")
    elif isinstance(obj, int):
        out.append(str(obj))
    elif isinstance(obj, float):
        if obj != obj:
            out.append("NaN")
        else:
            out.append(repr(obj))
    elif isinstance(obj, str):
        out.append(_quote(obj))
    elif isinstance(obj, list):
        if len(obj) == 0:
            out.append("[]")
            return
        out.append("[")
        first = True
        for item in obj:
            if not first:
                out.append("," if indent >= 0 else ", ")
            first = False
            if indent >= 0:
                out.append("\n" + " " * (indent * (level + 1)))
            _dump(item, out, indent, level + 1, sort_keys)
        if indent >= 0:
            out.append("\n" + " " * (indent * level))
        out.append("]")
    elif isinstance(obj, dict):
        if len(obj) == 0:
            out.append("{}")
            return
        out.append("{")
        keys: list[Any] = []
        for k in obj:
            keys.append(k)
        if sort_keys:
            keys.sort()
        first = True
        for k in keys:
            if not first:
                out.append("," if indent >= 0 else ", ")
            first = False
            if indent >= 0:
                out.append("\n" + " " * (indent * (level + 1)))
            out.append(_quote(str(k)))
            out.append(": ")
            _dump(obj[k], out, indent, level + 1, sort_keys)
        if indent >= 0:
            out.append("\n" + " " * (indent * level))
        out.append("}")
    else:
        raise TypeError(f"Object of type {type(obj).__name__} is not JSON serializable")


class _Parser:
    s: str
    i: int

    def __init__(self, s: str) -> None:
        self.s = s
        self.i = 0

    def error(self, msg: str) -> JSONDecodeError:
        return JSONDecodeError(f"{msg}: char {self.i}")

    def ws(self) -> None:
        while self.i < len(self.s) and self.s[self.i] in " \t\n\r":
            self.i += 1

    def value(self) -> Any:
        self.ws()
        if self.i >= len(self.s):
            raise self.error("Expecting value")
        c = self.s[self.i]
        if c == "{":
            return self.obj()
        if c == "[":
            return self.arr()
        if c == '"':
            return self.string()
        if self.s.startswith("true", self.i):
            self.i += 4
            return True
        if self.s.startswith("false", self.i):
            self.i += 5
            return False
        if self.s.startswith("null", self.i):
            self.i += 4
            return None
        return self.number()

    def obj(self) -> Any:
        self.i += 1
        d: dict[str, Any] = {}
        self.ws()
        if self.i < len(self.s) and self.s[self.i] == "}":
            self.i += 1
            return d
        while True:
            self.ws()
            if self.i >= len(self.s) or self.s[self.i] != '"':
                raise self.error("Expecting property name enclosed in double quotes")
            k = self.string()
            self.ws()
            if self.i >= len(self.s) or self.s[self.i] != ":":
                raise self.error("Expecting ':' delimiter")
            self.i += 1
            d[k] = self.value()
            self.ws()
            if self.i < len(self.s) and self.s[self.i] == ",":
                self.i += 1
                continue
            if self.i < len(self.s) and self.s[self.i] == "}":
                self.i += 1
                return d
            raise self.error("Expecting ',' delimiter")

    def arr(self) -> Any:
        self.i += 1
        items: list[Any] = []
        self.ws()
        if self.i < len(self.s) and self.s[self.i] == "]":
            self.i += 1
            return items
        while True:
            items.append(self.value())
            self.ws()
            if self.i < len(self.s) and self.s[self.i] == ",":
                self.i += 1
                continue
            if self.i < len(self.s) and self.s[self.i] == "]":
                self.i += 1
                return items
            raise self.error("Expecting ',' delimiter")

    def string(self) -> str:
        self.i += 1
        parts: list[str] = []
        start = self.i
        while True:
            if self.i >= len(self.s):
                raise self.error("Unterminated string")
            c = self.s[self.i]
            if c == '"':
                parts.append(self.s[start:self.i])
                self.i += 1
                return "".join(parts)
            if c == "\\":
                parts.append(self.s[start:self.i])
                self.i += 1
                e = self.s[self.i]
                if e == "n":
                    parts.append("\n")
                elif e == "t":
                    parts.append("\t")
                elif e == "r":
                    parts.append("\r")
                elif e == "b":
                    parts.append("\b")
                elif e == "f":
                    parts.append("\f")
                elif e == "u":
                    parts.append(chr(int(self.s[self.i + 1 : self.i + 5], 16)))
                    self.i += 4
                else:
                    parts.append(e)
                self.i += 1
                start = self.i
                continue
            self.i += 1

    def number(self) -> Any:
        start = self.i
        is_float = False
        while self.i < len(self.s) and self.s[self.i] in "+-0123456789.eE":
            if self.s[self.i] in ".eE":
                is_float = True
            self.i += 1
        text = self.s[start:self.i]
        if text == "":
            raise self.error("Expecting value")
        if is_float:
            return float(text)
        return int(text)


def loads(s: str) -> Any:
    p = _Parser(s)
    v = p.value()
    p.ws()
    if p.i != len(s):
        raise p.error("Extra data")
    return v
