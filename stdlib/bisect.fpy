# fpython stdlib: bisect
def bisect_left[T](a: list[T], x: T) -> int:
    lo = 0
    hi = len(a)
    while lo < hi:
        mid = (lo + hi) // 2
        if a[mid] < x:
            lo = mid + 1
        else:
            hi = mid
    return lo


def bisect_right[T](a: list[T], x: T) -> int:
    lo = 0
    hi = len(a)
    while lo < hi:
        mid = (lo + hi) // 2
        if x < a[mid]:
            hi = mid
        else:
            lo = mid + 1
    return lo


def bisect[T](a: list[T], x: T) -> int:
    return bisect_right(a, x)


def insort[T](a: list[T], x: T) -> None:
    a.insert(bisect_right(a, x), x)


def insort_left[T](a: list[T], x: T) -> None:
    a.insert(bisect_left(a, x), x)
